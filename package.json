{
  "name": "katiba-yetu",
  "version": "0.3.1",
  "private": true,
  "description": "Katiba Yetu — Tanzania Constitutional Deliberation Platform",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test:library": "node --test scripts/constitution.test.cjs",
    "import:constitution": "node scripts/import-constitution.cjs",
    "seed:supabase": "node --env-file=.env scripts/seed-supabase.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~57.0.23",
    "expo-clipboard": "~57.0.2",
    "expo-font": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-safe-area-context",
        "react-dom"
      ]
    }
  }
}
